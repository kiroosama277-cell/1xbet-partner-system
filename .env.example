# Database Configuration
# For local development with SQLite:
# DATABASE_URL="file:./dev.db"

# For Vercel deployment with PostgreSQL (e.g., Vercel Postgres, Supabase, Neon):
DATABASE_URL="postgres://user:password@host:5432/database?pgbouncer=true"
DIRECT_URL="postgres://user:password@host:5432/database"

# Note: DATABASE_URL with pgbouncer is for pooled connections (used by Prisma in serverless)
# DIRECT_URL is for direct connections (used for migrations and introspection)