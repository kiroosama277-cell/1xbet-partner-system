# ========================================
# 1xBet Partner System - Environment Variables
# ========================================

# Vercel Deployment (PostgreSQL)
# ----------------------------------------
# After connecting Neon database in Vercel, use one of these variables:

# Neon typically creates these variables:
# - DATABASE_URL (pooled, with pgbouncer)
# - DATABASE_URL_UNPOOLED (direct connection)

# Use DATABASE_URL for Prisma:
DATABASE_URL="postgres://user:password@host:5432/database"

# ========================================
# Local Development (SQLite) - Optional
# ========================================
# For local Windows development, change schema.prisma to:
# datasource db {
#   provider = "sqlite"
#   url      = env("DATABASE_URL")
# }
# Then use:
# DATABASE_URL="file:./dev.db"